# Copy to .env for running fetch_jobs.py on your own computer.
# On GitHub these come from Settings > Secrets and variables > Actions.
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=

# Optional one-off search, e.g. QA Testing jobs in Hyderabad
SEARCH_QUERY=

# Application status from Gmail (My jobs): your Gmail and a Google "App password", not your real password
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Which app account gets the statuses, if it isn't the same as GMAIL_ADDRESS
TRACK_ACCOUNT=
